{
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.configureOnOpen": true,
    "cmake.generator": "Unix Makefiles",
    "cmake.configureArgs": [
        "-DCMAKE_BUILD_TYPE=Debug"
    ],
    "files.associations": {
        "*.ld": "linkerscript",
        "*.s": "arm",
        "*.S": "arm",
        "dmod.h": "c",
        "dmlog.h": "c",
        "dmheap.h": "c",
        "dmenv.h": "c"
    },
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.errorSquiggles": "enabled",
    "cortex-debug.openocdPath": "/usr/bin/openocd",
    "cortex-debug.armToolchainPath": "/usr/bin",
    "cortex-debug.gdbPath": "gdb-multiarch",
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "files.exclude": {
        "**/build": false
    },
    "cortex-debug.variableUseNaturalFormat": true,
    "chat.tools.terminal.autoApprove": {
        "/^echo check_v0 && ls -l /tmp/dmdevfs_v0_verbose\\.log /tmp/openocd_v0\\.log /tmp/monitor_v0\\.log 2>/dev/null \\|\\| true && grep -E \"arm-none-eabi-gcc \\.\\*dmdevfs\\\\\\.c\\\\\\.o \\.\\* -c /data/projects/chocotechnologies/public/dmdevfs/src/dmdevfs\\\\\\.c\" /tmp/dmdevfs_v0_verbose\\.log 2>/dev/null \\| head -1 && \\(grep -q \"HardFault\" /tmp/openocd_v0\\.log && echo \"V0_RESULT=HARDFAULT\" \\|\\| echo \"V0_RESULT=NO_HARDFAULT_IN_OPENOCD\"\\)$/": {
            "approve": true,
            "matchCommandLine": true
        }
    }
}