# GDB initialization script for connecting to QEMU
# This script automatically connects to QEMU and sets up debugging environment
# Generated for target: @TARGET@

# Connect to QEMU GDB server running on localhost:3333
target extended-remote localhost:3333

# Load the ELF file into target memory
load

# Set the program counter to entry point (already done by load)
# Continue execution in background and detach so monitor-gdb can connect
continue &
detach
