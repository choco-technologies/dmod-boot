#
# Common services that are not needed to bring /ext up (flash.dmd keeps the ones that are)
#
# Like tools.dmd: they go into the firmware, or - DMBOOT_EXT_TOOLS, set by a board that has an external flash - to
# /ext/bin (their units and rules to /ext/cfg), which libsystemd loads once /ext is mounted.
#
dmdevmon
dmdevmon service=dmdevmon@.ini
dmdevmon rules=dmdevmon.rules
# Bind RTC devices to the shared UTC library through libsystemd rules.
dmutc service=dmutc@.ini
dmutc rules=dmutc.rules
