#
# Common flash modules - loaded for all targets
#
dmell
dmffs
dmramfs
dmdevfs
#
# The tools the system needs when /ext (the external flash) is not there - to see what is mounted, to mount, unmount
# and create a file system on it, to send files to it. The other tools: tools.dmd (the firmware or /ext).
#
ls
mount
umount
ymodem
tty
systemd
dmtty driver=dmtty.ini
console rules=console.rules
console service=console@.ini
dmdevmon
dmdevmon service=dmdevmon@.ini
dmdevmon rules=dmdevmon.rules
# Bind RTC devices to the shared UTC library through libsystemd rules.
dmutc service=dmutc@.ini
dmutc rules=dmutc.rules
