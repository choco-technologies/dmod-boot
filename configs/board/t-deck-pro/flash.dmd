#
# LILYGO T-Deck Pro flash modules
#
# The external RAM: 8 MB QUAD PSRAM on the memory SPI of the chip (chip select 1) - the controller is dmqspi, the chip dmpsram (one
# friends_group of board/t-deck-pro.ini). It is mapped into the address space and put at the end of the default heaps; it needs the clock
# of dmclk (the mcu flash.dmd, driver_order).
dmqspi
dmpsram driver=board/t-deck-pro.ini

#
# The e-paper (GDEQ031T10, UC8253) on GP-SPI2: dmuc8253 is the driver, dmspi the bus (its transfers go by the DMA of dmdma), dmgpio the
# D/C, BUSY and chip select lines. One friends_group of the ini file holds the display and everything it is wired to; the ini also holds
# the chip selects of the SD card and the radio that share the bus. The logo of the splash screen is DMBOOT_SPLASH_LOGO of board.cmake.
dmdma driver=mcu/esp32s3.ini
dmgpio
dmspi
dmuc8253 driver=board/t-deck-pro/display.ini

#
# The touch panel over the e-paper (CST3530, a CST66xx, at 0x1A on the I2C bus of the board: SDA GPIO13, SCL GPIO14, reset GPIO38). dmi2c is the bus,
# dmgpio the reset line (already loaded above), dmcst66xx the driver: one friends_group of the ini file.
dmi2c
dmcst66xx driver=board/t-deck-pro/touch.ini
# The keyboard (TCA8418 at 0x34 on the same bus; the keys' light is GPIO42): it joins the friends_group of the e-paper (keyboard.ini of dmtca8418),
# takes the bus of the touch panel from it, and inputd.rules (below) starts an inputd for it, which gives its keys to libinput.
dmtca8418 driver=board/t-deck-pro/keyboard.ini
dmtca8418 layout=layouts/t-deck-pro.ini

#
# The graphical interface: dmview is the display service (dmdevfs reports the e-paper, dmview.rules starts a dmview@<name> for it, which shows
# what the applications claim for it and takes the input of the display's friends group from libinput), phoneui the application
# that claims the display for its view, phoneui_view the views - the bundle of this board's screen (epaper-240x320) is built into the firmware
# (/eviews/phoneui_view/phoneui.dmv). See the phoneui repository.
dmview @screen epaper-240x320
dmview service=dmview@.ini
dmview rules=dmview.rules
# The input: dmdevfs reports the touch panel as an input, inputd.rules starts an inputd for it, which gives what it reports to libinput
# (where dmview reads the touches of its display from).
inputd service=inputd@.ini
inputd rules=inputd.rules
libinput keymap=keymaps/en.ini
libinput keymap=keymaps/pl.ini
phoneui service=phoneui.ini
phoneui_view @screen epaper-240x320
#
# hello - a small application of the launcher (it has an icon, so phoneui lists it; it lives in a rent of the screen): a test of the screen
# rent and of the icons. Its icon for this board's screen (epaper-240x320) goes to /eviews/icons/hello.dmvi.
hello @screen epaper-240x320
calculator @screen epaper-240x320
settings @screen epaper-240x320

#
# The Wi-Fi of the chip (dmespwifi): wlan0, started by the driver; networkd.rules and dhcp.rules start networkd@wlan0 and dhcp@wlan0 for it.
# The networks are set from the shell (wifi scan, wifi connect SSID PASSWORD) or in Settings; the saved ones (the "wifi" vault of dmsecrets on /ext)
# are connected to by wifid.
dmnetbridge
dmnetif
dmarp
dmroute
dmip
dmicmp service=icmp.ini
ifconfig
ip
ping
networkd service=networkd@.ini
networkd rules=networkd.rules
dmudp
dhcpc service=dhcp@.ini
dhcpc rules=dhcp.rules
dmespwifi driver=board/t-deck-pro/wifi.ini
wifi
#
# The time: there is no RTC chip on the board, dmrtc keeps the calendar with the RTC timer of the ESP32-S3 (it survives the resets, not the loss of the
# power; rtc.ini). dmdevfs reports the rtc node, dmutc.rules (tools.dmd) starts dmutc for it; dmntp (loaded at boot by the ntp unit) is one of dmutc's
# external UTC sources: dmutc sets the RTC from it as soon as the network is up (every minute until it succeeds), then once a day.
# `rtc` shows or sets the calendar by hand.
dmrtc driver=board/t-deck-pro/rtc.ini
rtc
dmntp service=ntp.ini
#
# The external flash: /ext is the last 9 MB of the flash of the chip (0x700000, board.cmake), the same chip and layout as on esp32s3-lcd28, so its
# dmflash configuration is used. dmflash exports it as the block node /dev/dmflashx/ext (the firmware does the erasing and programming from the internal
# RAM with the caches off), dmlittlefs keeps a littlefs on it, which the "ext" service (services/ext.ini) mounts at /ext. A new flash has no file system:
# create it once with `mklittlefs /dev/dmflashx/ext` (ALL DATA IN IT IS LOST). The vault of the networks is /ext/secrets.vault.
dmflash driver=board/esp32s3-lcd28/flash.ini
dmlittlefs
mklittlefs
#
# The vault: dmcrypto does the cryptography and takes its random bytes from /dev/rng (dmrng, the generator of the chip); the vault is opened with the
# key of the device secret (/dev/devkey), so nobody types a passphrase. wifid connects to the saved networks (it needs /ext, where the vault is).
dmrng driver=board/esp32s3-lcd28/rng.ini
dmcrypto driver=board/stm32f746g-disco/crypto.ini
crypto
dmsecrets
secrets
wifid service=wifid@.ini
wifid rules=wifid.rules

#
# The battery: the gauge (BQ27220 at 0x55 on the I2C bus of the board) is read by dmbq27220; its node (/dev/dmbq270) is the battery interface of dmdrvi
# (cat /dev/dmbq270). It joins the friends_group of the e-paper and takes the bus of the touch panel from it (battery.ini of dmbq27220).
dmbq27220 driver=board/t-deck-pro/battery.ini
