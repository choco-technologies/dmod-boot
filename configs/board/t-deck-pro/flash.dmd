#
# LILYGO T-Deck Pro flash modules
#
# The external RAM: 8 MB QUAD PSRAM on the memory SPI of the chip (chip select 1) - the controller is dmqspi, the chip dmpsram (one
# friends_group of board/t-deck-pro.ini). It is mapped into the address space and put at the end of the default heaps; it needs the clock
# of dmclk (the mcu flash.dmd, driver_order).
dmqspi
dmpsram driver=board/t-deck-pro.ini

#
# The e-paper (GDEQ031T10, UC8253) on GP-SPI2: dmuc8253 is the driver, dmspi the bus (its transfers go by the DMA of dmdma), dmgpio the
# D/C, BUSY and chip select lines. One friends_group of the ini file holds the display and everything it is wired to; the ini also holds
# the chip selects of the SD card and the radio that share the bus. The logo of the splash screen is DMBOOT_SPLASH_LOGO of board.cmake.
dmdma driver=mcu/esp32s3.ini
dmgpio
dmspi
dmuc8253 driver=board/t-deck-pro/display.ini

#
# The touch panel over the e-paper (CST3530, a CST66xx, at 0x1A on the I2C bus of the board: SDA GPIO13, SCL GPIO14, reset GPIO38). dmi2c is the bus,
# dmgpio the reset line (already loaded above), dmcst66xx the driver: one friends_group of the ini file.
dmi2c
dmcst66xx driver=board/t-deck-pro/touch.ini
# The keyboard (TCA8418 at 0x34 on the same bus; the keys' light is GPIO42): it joins the friends_group of the e-paper (keyboard.ini of dmtca8418),
# takes the bus of the touch panel from it, and inputd.rules (below) starts an inputd for it, which gives its keys to libinput.
dmtca8418 driver=board/t-deck-pro/keyboard.ini

#
# The graphical interface: dmview is the display service (dmdevfs reports the e-paper, dmview.rules starts a dmview@<name> for it, which shows
# what the applications claim for it and takes the input of the display's friends group from libinput), phoneui the application
# that claims the display for its view, phoneui_view the views - the bundle of this board's screen (epaper-240x320) is built into the firmware
# (/eviews/phoneui_view/phoneui.dmv). See the phoneui repository.
dmview
dmview service=dmview@.ini
dmview rules=dmview.rules
# The input: dmdevfs reports the touch panel as an input, inputd.rules starts an inputd for it, which gives what it reports to libinput
# (where dmview reads the touches of its display from).
inputd service=inputd@.ini
inputd rules=inputd.rules
# The Polish keymap for LANG=pl_PL.UTF-8 (it lands in /cfg/keymaps/libinput/pl.ini); without LANG the built in English one is used.
libinput keymap=pl.ini
phoneui service=phoneui.ini
phoneui_view @screen epaper-240x320
