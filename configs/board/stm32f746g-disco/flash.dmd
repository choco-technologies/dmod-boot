#
# STM32F746G Discovery board flash modules - board-specific modules with configs
#
dmclk driver=board/stm32f746g-disco.ini
dmgpio driver=board/stm32f746g-disco.ini
dmuart driver=board/stm32f746g-disco/usart1.ini
dmuart driver=board/stm32f746g-disco/usart6.ini
dmfmc driver=board/stm32f746g-disco/sdram.ini
dmdma driver=board/stm32f746g-disco/dma.ini
# Hardware entropy source (/dev/rng); CLK48 comes from dmclk.
dmrng driver=board/stm32f746g-disco/rng.ini
test_dmrng
#
# Network: eth0 on the on-board RMII PHY. dmnetif reports the interface as a
# "netif" device, networkd.rules and dhcp.rules then start networkd@eth0 (RX
# pump) and dhcp@eth0 (lease) for it. The pump brings eth0 up by itself once
# the PHY reports a link (dmnetbridge 1.2.4+), so DHCP needs no manual
# "ifconfig eth0 up".
#
dmeth driver=board/stm32f746g-disco/eth0.ini
dmnetbridge
dmnetif
dmarp
dmroute
dmip
dmicmp service=icmp.ini
ifconfig
ip
ping
networkd service=networkd@.ini
networkd rules=networkd.rules
dmudp
dhcpc service=dhcp@.ini
dhcpc rules=dhcp.rules
test_dmeth
#
# Telnet: telnetd (dmtcp + dmtelnet) listens on TCP port 23; every connection
# becomes a tty node with its own console@ / dmell, like a UART does.
#
telnetd driver=telnetd.ini
#
# SD card: on-board microSD slot (CN3) on SDMMC1. dmdevfs creates the host
# node /dev/dmsdio0, the dmdevmon service (common flash.dmd) monitors the
# card detect pin and announces /dev/dmsdio0/0 when a card is inserted.
# The DMA2 controller (dma.ini) and CLK48 from dmclk must be up before it.
#
dmsdio driver=board/stm32f746g-disco/sdmmc1.ini
blkid
#
# SD card file systems: dmfatfs mounts FAT/exFAT, mkfatfs formats a card.
# automount (dmblock) mounts every FAT/exFAT volume dmdevfs reports as a
# block device at /mnt/<label> (or /mnt/<node name>) and unmounts it when
# the card is removed.
#
dmfatfs
mkfatfs
automount service=automount@.ini
automount rules=automount.rules
dmlcdtft driver=board/stm32f746g-disco/lcd.ini
#
# Touch panel of the LCD: FT5336 on I2C3. dmft5336's touch.ini configures
# the I2C3 pins, the dmi2c bus (/dev/dmi2cx/touch_i2c, its i2c_bus friend)
# and the panel (/dev/touch, polled: its INT pin shares EXTI13 with the
# microSD card detect) - dmi2c is only needed as a module here, its own
# i2c3.ini would configure the same controller a second time.
#
dmi2c
dmft5336 driver=board/stm32f746g-disco/touch.ini
#
# Audio: the WM8994 codec - stereo headphone output and the board's digital
# microphone - on SAI2 (PCM, dmsai) with I2C3 for its registers. The config
# joins the touch panel's I2C3 bus node (touch.ini above) instead of
# configuring I2C3 again, so both work at once. The nodes are /dev/wm8994
# (codec controls and stereo PCM) and /dev/dmsai1 (the raw SAI stream the codec
# drives); an application plays through /dev/wm8994 with the DMDRVI_IOCTL_AUDIO_*
# commands (dmdrvi 2.7). dmsai needs dmclk (SAI clock), dmdma (DMA2) and dmheap.
#
dmsai
dmwm8994 driver=board/stm32f746g-disco/codec-with-touch.ini
#
# The audio service: dmaudio.rules starts a dmaudio@<name> for every audio
# device dmdevfs reports - here /dev/wm8994 -, mixing what the applications
# play (libdmaudio) into it.
#
dmaudio service=dmaudio@.ini
dmaudio rules=dmaudio.rules
#
# The display service: dmview.rules starts a dmview@<name> for the LCD
# (/dev/dmlcdtft0), which shows what the applications claim for it - with
# the channel between an application and its view (0.10), which carhmi needs.
#
dmview@>=0.10
dmview@>=0.10 service=dmview@.ini
dmview@>=0.10 rules=dmview.rules
#
# The car HMI demo (choco-technologies/carhmi-demo): a service that claims the
# display for its view - on the SD card, see sdcard.dmd - and plays the MP3
# files of the card's music/ directory through dmaudio.
#
carhmi service=carhmi.ini
