; carhmi.rules - libsystemd device rule of the board.
;
; libsystemd reports every mount as a device of class "mount" (dmfsi's _mount_changed dif, called by dmvfs), named
; after the mount point ("/mnt/SD" -> "mnt_SD", "/ext" -> "ext"). The module carhmi is on the card, so it can only
; start once the card is mounted: for each mount carhmi-start starts an instance of carhmi@.ini, which finds the module
; only on the card (for the other mounts it fails, with a warning). The instance stops again before its mount is
; unmounted - the unmount waits for carhmi-stop.
;
; Load with libsystemd_load_rules() on the directory this file lives in.
[class=mount]
start=carhmi-start@%name
remove=carhmi-stop@%name
