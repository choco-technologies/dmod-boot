 /**
+ * Like esp_gdma_get_channel_periph, but the channel must be both selected for the peripheral AND started: an idle channel keeps the
+ * reset value of PERI_SEL (0, the SPI2), so a peripheral that shares the GDMA with others (the SPI2 with its two channels) needs both.
+ */
+bool esp_gdma_get_started_channel_periph(ESPGdmaState *s, GdmaPeripheral periph, int dir, uint32_t* chan)
+{
+    if (s == NULL || chan == NULL || periph > GDMA_LAST || dir < 0 || dir >= ESP_GDMA_CONF_COUNT) {
+        return false;
+    }
+
+    const ESPGdmaClass* class = ESP_GDMA_GET_CLASS(s);
+
+    if (class->is_periph_invalid && class->is_periph_invalid(s, periph)) {
+        return false;
+    }
+
+    const uint32_t sel = class->periph_sel ? class->periph_sel(periph) : periph;
+
+    for (int i = 0; i < class->m_channel_count; i++) {
+        const uint32_t link = s->ch_conf[dir][i].link;
+        const bool started = (dir == ESP_GDMA_IN_IDX) ? FIELD_EX32(link, GDMA_IN_LINK, START)
+                                                      : FIELD_EX32(link, GDMA_OUT_LINK, START);
+        if (FIELD_EX32(s->ch_conf[dir][i].peripheral, GDMA_PERI_SEL, PERI_SEL) == sel && started) {
+            *chan = i;
+            return true;
+        }
+    }
+
+    return false;
+}
