@@ -0,0 +1,31 @@
+/*
+ * ESP32-S3 general purpose SPI (GP-SPI2) master, enough to talk to an SPI device (an SD card) the way dmspi does:
+ * the data of up to 64 bytes in W0..W15 (CPU) or through the GDMA, one transaction per CMD.USR.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+#pragma once
+
+#include "hw/sysbus.h"
+#include "hw/ssi/ssi.h"
+#include "hw/dma/esp_gdma.h"
+
+#define TYPE_ESP32S3_GPSPI "esp32s3.gpspi"
+#define ESP32S3_GPSPI(obj) OBJECT_CHECK(ESP32S3GpSpiState, (obj), TYPE_ESP32S3_GPSPI)
+
+#define ESP32S3_GPSPI_REGS_SIZE 0x100
+#define ESP32S3_GPSPI_BUF_WORDS 16
+
+typedef struct ESP32S3GpSpiState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    SSIBus *spi;
+    qemu_irq irq;
+    ESPGdmaState *gdma;
+    uint32_t periph;                    /* the GDMA peripheral: GDMA_SPI2 or GDMA_SPI3 */
+
+    uint32_t regs[ESP32S3_GPSPI_REGS_SIZE / 4];
+} ESP32S3GpSpiState;
