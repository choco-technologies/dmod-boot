@@ -0,0 +1,212 @@
+/*
+ * ESP32-S3 general purpose SPI (GP-SPI2) master
+ *
+ * A model of what the driver of dmod needs: the master mode, 1 bit, one transaction of up to 64 bytes from W0..W15 or any size through
+ * the GDMA (the peripheral SPI2/SPI3), the interrupt TRANS_DONE. The clock, the modes and the pins (GPIO matrix) are not modelled: the
+ * data goes to the SSI bus, the chip select of the device on it is a GPIO of the board (see the machine).
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "hw/hw.h"
+#include "hw/irq.h"
+#include "hw/sysbus.h"
+#include "hw/qdev-properties.h"
+#include "hw/ssi/esp32s3_gpspi.h"
+
+#define R_CMD           0x00
+#define R_CTRL          0x08
+#define R_USER          0x10
+#define R_MS_DLEN       0x1C
+#define R_DMA_CONF      0x30
+#define R_DMA_INT_ENA   0x34
+#define R_DMA_INT_CLR   0x38
+#define R_DMA_INT_RAW   0x3C
+#define R_DMA_INT_ST    0x40
+#define R_W0            0x98
+
+#define CMD_UPDATE      (1u << 23)
+#define CMD_USR         (1u << 24)
+#define CTRL_RD_BIT_ORDER (1u << 23)    /* 1: LSB first */
+#define CTRL_WR_BIT_ORDER (1u << 25)
+#define USER_USR_MOSI   (1u << 27)
+#define USER_USR_MISO   (1u << 28)
+#define DMA_CONF_RX_ENA (1u << 27)
+#define DMA_CONF_TX_ENA (1u << 28)
+#define INT_TRANS_DONE  (1u << 12)
+#define MAX_DMA_BYTES   (1u << 15)
+
+static uint8_t rev8(uint8_t b)
+{
+    b = (b & 0xF0) >> 4 | (b & 0x0F) << 4;
+    b = (b & 0xCC) >> 2 | (b & 0x33) << 2;
+    b = (b & 0xAA) >> 1 | (b & 0x55) << 1;
+    return b;
+}
+
+static void esp32s3_gpspi_update_irq(ESP32S3GpSpiState *s)
+{
+    s->regs[R_DMA_INT_ST / 4] = s->regs[R_DMA_INT_RAW / 4] & s->regs[R_DMA_INT_ENA / 4];
+    qemu_set_irq(s->irq, s->regs[R_DMA_INT_ST / 4] != 0);
+}
+
+/* One transaction: MS_DLEN + 1 bits */
+static void esp32s3_gpspi_run(ESP32S3GpSpiState *s)
+{
+    const uint32_t bits = (s->regs[R_MS_DLEN / 4] & 0x3FFFF) + 1;
+    uint32_t n = (bits + 7) / 8;
+    const bool dma_tx = s->regs[R_DMA_CONF / 4] & DMA_CONF_TX_ENA;
+    const bool dma_rx = s->regs[R_DMA_CONF / 4] & DMA_CONF_RX_ENA;
+    const bool lsb_out = s->regs[R_CTRL / 4] & CTRL_WR_BIT_ORDER;
+    const bool lsb_in = s->regs[R_CTRL / 4] & CTRL_RD_BIT_ORDER;
+    uint8_t *tx = g_malloc0(MAX_DMA_BYTES);
+    uint8_t *rx = g_malloc0(MAX_DMA_BYTES);
+    uint32_t chan;
+
+    if (n > MAX_DMA_BYTES) {
+        n = MAX_DMA_BYTES;
+    }
+    if (dma_tx) {
+        if (!esp_gdma_get_started_channel_periph(s->gdma, s->periph, ESP_GDMA_OUT_IDX, &chan) ||
+            !esp_gdma_read_channel(s->gdma, chan, tx, n)) {
+            qemu_log_mask(LOG_GUEST_ERROR, "esp32s3.gpspi: no GDMA OUT channel for the transfer\n");
+            memset(tx, 0xFF, n);
+        }
+    } else {
+        if (n > ESP32S3_GPSPI_BUF_WORDS * 4) {
+            n = ESP32S3_GPSPI_BUF_WORDS * 4;
+        }
+        for (uint32_t i = 0; i < n; i++) {
+            tx[i] = s->regs[R_W0 / 4 + i / 4] >> (8 * (i % 4));
+        }
+    }
+
+    for (uint32_t i = 0; i < n; i++) {
+        uint8_t out = lsb_out ? rev8(tx[i]) : tx[i];
+        uint8_t in = ssi_transfer(s->spi, out);
+        rx[i] = lsb_in ? rev8(in) : in;
+    }
+
+    if (dma_rx) {
+        const uint32_t rn = (n + 3) & ~3u;     /* the controller writes whole words */
+        if (!esp_gdma_get_started_channel_periph(s->gdma, s->periph, ESP_GDMA_IN_IDX, &chan) ||
+            !esp_gdma_write_channel(s->gdma, chan, rx, rn)) {
+            qemu_log_mask(LOG_GUEST_ERROR, "esp32s3.gpspi: no GDMA IN channel for the transfer\n");
+        }
+    } else {
+        memset(&s->regs[R_W0 / 4], 0, ESP32S3_GPSPI_BUF_WORDS * 4);
+        for (uint32_t i = 0; i < n; i++) {
+            s->regs[R_W0 / 4 + i / 4] |= (uint32_t)rx[i] << (8 * (i % 4));
+        }
+    }
+    g_free(tx);
+    g_free(rx);
+
+    s->regs[R_DMA_INT_RAW / 4] |= INT_TRANS_DONE;
+    esp32s3_gpspi_update_irq(s);
+}
+
+static uint64_t esp32s3_gpspi_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    ESP32S3GpSpiState *s = ESP32S3_GPSPI(opaque);
+
+    if (addr >= ESP32S3_GPSPI_REGS_SIZE) {
+        return 0;
+    }
+    return s->regs[addr / 4];
+}
+
+static void esp32s3_gpspi_write(void *opaque, hwaddr addr, uint64_t value, unsigned int size)
+{
+    ESP32S3GpSpiState *s = ESP32S3_GPSPI(opaque);
+    const uint32_t v = (uint32_t)value;
+
+    if (addr >= ESP32S3_GPSPI_REGS_SIZE) {
+        return;
+    }
+    switch (addr) {
+    case R_CMD:
+        /* UPDATE completes at once; USR runs the transaction (which is instantaneous here) */
+        s->regs[R_CMD / 4] = v & ~(CMD_UPDATE | CMD_USR);
+        if (v & CMD_USR) {
+            esp32s3_gpspi_run(s);
+        }
+        break;
+    case R_DMA_INT_CLR:
+        s->regs[R_DMA_INT_RAW / 4] &= ~v;
+        esp32s3_gpspi_update_irq(s);
+        break;
+    case R_DMA_INT_ENA:
+        s->regs[R_DMA_INT_ENA / 4] = v;
+        esp32s3_gpspi_update_irq(s);
+        break;
+    case R_DMA_INT_RAW:
+    case R_DMA_INT_ST:
+        break;
+    default:
+        s->regs[addr / 4] = v;
+        break;
+    }
+}
+
+static const MemoryRegionOps esp32s3_gpspi_ops = {
+    .read = esp32s3_gpspi_read,
+    .write = esp32s3_gpspi_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .impl.min_access_size = 4,
+    .impl.max_access_size = 4,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+};
+
+static void esp32s3_gpspi_reset(DeviceState *dev)
+{
+    ESP32S3GpSpiState *s = ESP32S3_GPSPI(dev);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    qemu_set_irq(s->irq, 0);
+}
+
+static void esp32s3_gpspi_init(Object *obj)
+{
+    ESP32S3GpSpiState *s = ESP32S3_GPSPI(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->iomem, obj, &esp32s3_gpspi_ops, s, TYPE_ESP32S3_GPSPI, 0x1000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+    s->spi = ssi_create_bus(DEVICE(obj), "spi");
+}
+
+static Property esp32s3_gpspi_properties[] = {
+    DEFINE_PROP_UINT32("periph", ESP32S3GpSpiState, periph, GDMA_SPI2),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void esp32s3_gpspi_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    device_class_set_legacy_reset(dc, esp32s3_gpspi_reset);
+    device_class_set_props(dc, esp32s3_gpspi_properties);
+}
+
+static const TypeInfo esp32s3_gpspi_info = {
+    .name = TYPE_ESP32S3_GPSPI,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(ESP32S3GpSpiState),
+    .instance_init = esp32s3_gpspi_init,
+    .class_init = esp32s3_gpspi_class_init,
+};
+
+static void esp32s3_gpspi_register_types(void)
+{
+    type_register_static(&esp32s3_gpspi_info);
+}
+
