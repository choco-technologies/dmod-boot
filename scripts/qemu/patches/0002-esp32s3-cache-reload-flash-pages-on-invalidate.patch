+/* Reload the cached copy of the flash pages overlapping [addr, addr + size): the flash may have been
+ * erased/programmed through the SPI controller since the page was mapped. */
+static void esp32s3_cache_reload_range(ESP32S3CacheState *s, uint32_t addr, uint32_t size)
+{
+    ESP32S3XtsAesClass *xts_aes_class = ESP32S3_XTS_AES_GET_CLASS(s->xts_aes);
+    if (s->flash_blk == NULL || size == 0) {
+        return;
+    }
+    uint32_t off = addr & 0x1FFFFFF;
+    uint32_t first = off / ESP32S3_PAGE_SIZE;
+    uint32_t last = (off + size - 1) / ESP32S3_PAGE_SIZE;
+    for (uint32_t i = first; i <= last && i < ESP32S3_MMU_TABLE_ENTRY_COUNT; i++) {
+        ESP32S3MMUEntry e = s->mmu[i];
+        if (e.invalid || e.type != ESP32S3_MMU_TYPE_FLASH) {
+            continue;
+        }
+        uint32_t phys = e.page_number * ESP32S3_PAGE_SIZE;
+        uint8_t *data = ((uint8_t *) memory_region_get_ram_ptr(&s->flash_mr)) + phys;
+        blk_pread(s->flash_blk, phys, ESP32S3_PAGE_SIZE, data, 0);
+        if (xts_aes_class->is_flash_enc_enabled(s->xts_aes)) {
+            xts_aes_class->decrypt(s->xts_aes, phys, data, ESP32S3_PAGE_SIZE);
+        }
+    }
+}
