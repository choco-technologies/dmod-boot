# Renode script for STM32F746 Discovery board emulation
# This script is used by renode_connect.sh when DMBOOT_QEMU=ON

# Create machine
mach create "stm32f746"

# Load STM32F746 platform
machine LoadPlatformDescription @platforms/boards/stm32f7_discovery-kit.repl

# Set up GDB server on port 3333 (compatible with OpenOCD)
machine StartGdbServer 3333

# Show analyzer for UART output
showAnalyzer sysbus.usart1

# Load firmware (path will be set by script)
# This is a placeholder - actual path passed via command line

# Start emulation
# start
