# Keep a module output directory limited to .dmf/.dmfc files. During migration,
# preserve old package resources/markers outside it; never overwrite a backup.
if(NOT MODULE_DIR)
    message(FATAL_ERROR "MODULE_DIR is required")
endif()
if(NOT CHECK_ONLY AND NOT PACKAGE_DIR)
    message(FATAL_ERROR "PACKAGE_DIR is required when preparing the output")
endif()
file(MAKE_DIRECTORY "${MODULE_DIR}")
file(GLOB _ENTRIES LIST_DIRECTORIES true "${MODULE_DIR}/*")
foreach(_ENTRY IN LISTS _ENTRIES)
    if(NOT IS_DIRECTORY "${_ENTRY}" AND _ENTRY MATCHES "\\.dmfc?$")
        continue()
    endif()
    if(CHECK_ONLY)
        message(FATAL_ERROR "Non-module entry in binary directory: ${_ENTRY}")
    endif()
    get_filename_component(_NAME "${_ENTRY}" NAME)
    set(_BACKUP "${PACKAGE_DIR}/legacy-output/${_NAME}")
    if(EXISTS "${_BACKUP}" OR IS_SYMLINK "${_BACKUP}")
        message(FATAL_ERROR "Cannot preserve ${_ENTRY}: ${_BACKUP} already exists")
    endif()
    file(MAKE_DIRECTORY "${PACKAGE_DIR}/legacy-output")
    file(RENAME "${_ENTRY}" "${_BACKUP}")
    message(STATUS "Preserved old module resource: ${_BACKUP}")
endforeach()
