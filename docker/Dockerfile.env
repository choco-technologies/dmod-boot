FROM chocotechnologies/dmod:1.1

RUN apt-get update -qq && apt-get install -y \
        wget \
        file \
        libncurses6 \
        policykit-1 \
        libgtk2.0-0t64 \
        screen \
        uml-utilities \
        libc6-dev \
        gcc \
        python3 \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

# The .deb depends on GTK# 2 packages unavailable on Ubuntu 24.04.
# Use the portable distribution, which bundles its Mono runtime, instead.
ENV RENODE_VERSION="1.15.3"
ENV RENODE_DIR=/opt/renode
ENV PATH="${RENODE_DIR}:${PATH}"
RUN wget -q "https://github.com/renode/renode/releases/download/v${RENODE_VERSION}/renode-${RENODE_VERSION}.linux-portable.tar.gz" -O /tmp/renode.tar.gz \
    && mkdir -p "${RENODE_DIR}" \
    && tar -xzf /tmp/renode.tar.gz --strip-components=1 -C "${RENODE_DIR}" \
    && rm /tmp/renode.tar.gz \
    && renode --version \
    && file --version

# Install dmffs
RUN dmf-get make_dmffs --type dmf
RUN echo "alias make_dmffs='dmod_loader ${DMOD_DMF_DIR}/make_dmffs.dmf --args'" >> ~/.bashrc


# The Espressif QEMU (esp32s3 machine) with the patches of scripts/qemu, for the tests of the ESP32-S3 firmware
# (scripts/run_qemu_tests.sh). The build tools are removed afterwards, the runtime libraries stay.
# The build context is the root of the repository (docker build -f docker/Dockerfile.env .).
COPY scripts/qemu /tmp/qemu-build
ENV QEMU_ESP32S3_DIR=/opt/qemu-esp32s3
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
        curl xz-utils patch ninja-build pkg-config \
        libglib2.0-dev libgcrypt20-dev libpixman-1-dev libslirp-dev \
    && /tmp/qemu-build/build-qemu.sh "${QEMU_ESP32S3_DIR}" \
    && rm -rf /tmp/qemu-build /var/lib/apt/lists/*
